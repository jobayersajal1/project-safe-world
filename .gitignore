# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Env
.env
.env.local

# Blocklists — never tracked here, in ANY encoding.
#
# The complete list lives only in the private repo jobayersajal1/safe-world-listed,
# scrambled. `npm run lists:pull` decodes it into a working copy, the build
# scripts turn that into the per-platform artifacts below, and those go straight
# into a built package. None of it is committed: a scrambled list in a public
# repo is still a published list, just a slightly inconvenient one.
#
# If you are adding a build output that contains domains, add it here too.
packages/core/src/blocklists/
baseline/
apps/chrome-extension/public/lists/
apps/chrome-extension/src/rules/
apps/ios/SafeWorldCore/Sources/SafeWorldCore/Resources/
apps/ios/SafeWorldBlocker/Resources/blockerList.json
apps/windows/SafeWorld.Core/Resources/
apps/windows/SafeWorld.App/filters/
apps/android/core/src/main/resources/blocklists/

# Android signing. The keystore IS the app's identity — committing it lets
# anyone publish an update that Android accepts as genuine. Back it up
# somewhere private instead; it cannot be regenerated, only replaced.
*.jks
*.keystore
keystore.properties

# macOS packaging scratch
apps/macos/dmg-staging/
apps/macos/dist/

# NDK / CMake build output
.cxx/

# Xcode / Swift
.build/
build/
# Device (Release-iphoneos) output, kept separate from the simulator's `build/`
# so both can exist at once. Contains the bundled blocklists, so it must never
# be tracked — see the note at the top of this file.
build-device/
DerivedData/
*.xcuserstate
xcuserdata/

# .NET
bin/
obj/


# Python bytecode from the model-training scripts
__pycache__/
*.pyc

# Advisory model: generated from the blocklists by scripts/export-domain-model.py.
# Derived weights, not domains — but generated like every other list artifact,
# so one command rebuilds everything and a fresh clone has no stale copy.
packages/core/src/model/

# Advisory model, copied into the extension by scripts/build-advisory-model.ts.
apps/chrome-extension/public/model/

apps/android/core/src/main/resources/model/
