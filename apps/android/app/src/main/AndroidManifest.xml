<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        So protection comes back after a reboot. Without it the tunnel stayed down until someone
        opened the app, which on a device that is deliberately never opened again means protection
        quietly ended at the first restart.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        The app is distributed as a downloaded APK, not through a store, so it
        has to be able to install its own update. The user still has to grant
        this per-app in system settings, and still confirms each install.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SafeWorld">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SafeWorld">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The system starts this via the VPN consent flow, so it must declare
            BIND_VPN_SERVICE and the android.net.VpnService action. Android 14+
            additionally requires a foreground service type; a local filtering
            VPN has no better-fitting type than specialUse.
        -->
        <service
            android:name=".vpn.SafeWorldVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-device local VPN that filters DNS lookups to block harmful sites. No traffic leaves the device to any remote server." />
            <!--
                Declared explicitly rather than relying on the default. This is what makes Android
                offer the "Always-on VPN" and "Block connections without VPN" switches for this app,
                and those two settings are the only sanctioned answer to another VPN displacing us:
                the OS then restarts our tunnel itself and, with lockdown on, refuses to pass traffic
                while it is down. An app cannot do either for itself — there is no API to preempt
                another VPN, and Android 12+ forbids starting a foreground service from the
                background, so no watchdog can re-acquire the tunnel on its own.
            -->
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
        </service>

        <!--
            Device admin exists only so Android refuses to uninstall the app
            while it's active (uninstall friction). It requests no policies —
            see res/xml/device_admin.xml.
        -->
        <receiver
            android:name=".security.SafeWorldDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
            Restarts the tunnel after a reboot or an app update. Exported, because the sender is
            the system rather than us; the receiver itself does nothing an attacker could exploit —
            it starts protection, and only when the user had already enabled it.

            BOOT_COMPLETED and MY_PACKAGE_REPLACED are on Android 12's exemption list for starting
            a foreground service from the background, which is why only those are listed.
        -->
        <receiver
            android:name=".vpn.BootReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            Result callbacks from the PackageInstaller session that applies an
            update. Not exported: only the system sends to it, via the
            PendingIntent handed to session.commit().
        -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />
    </application>
</manifest>
