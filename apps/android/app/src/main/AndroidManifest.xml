<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        So protection comes back after a reboot. Without it the tunnel stayed down until someone
        opened the app, which on a device that is deliberately never opened again means protection
        quietly ended at the first restart.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        The app is distributed as a downloaded APK, not through a store, so it
        has to be able to install its own update. The user still has to grant
        this per-app in system settings, and still confirms each install.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        To let the user block an app that isn't in our built-in catalogue.

        Android 11 hid the installed-app list behind this, and a blocker that can only block the
        games we happened to think of is not much of a blocker — new ones appear constantly, and
        the one someone actually loses hours to is usually not on any list. Play grants this for
        parental-control and device-security apps, which is exactly what this is; the picker is
        the only thing that reads it, and nothing is transmitted anywhere.

        The <queries> block below is the fallback: it keeps the built-in catalogue working by name
        even if this permission is ever refused, because a curated list of packages we name
        explicitly needs no broad visibility.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!--
        The built-in catalogue, so it resolves even without QUERY_ALL_PACKAGES.

        Mirrors AppGroups.ALL in :core. Regenerate rather than hand-edit:

          grep -oE 'AppEntry\("[a-zA-Z0-9_.]+"' \
            core/src/main/kotlin/com/safeworld/core/AppGroups.kt \
            | sed -E 's/AppEntry\("([^"]+)"/\1/'

        A name here that is missing from AppGroups is harmless; one missing here that AppGroups has
        is not, if the permission is ever absent — that app silently resolves to nothing and is
        never blocked, which looks exactly like the feature working.
    -->
    <queries>
        <package android:name="com.facebook.katana" />
        <package android:name="com.facebook.lite" />
        <package android:name="com.instagram.android" />
        <package android:name="com.instagram.lite" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.ss.android.ugc.trill" />
        <package android:name="com.twitter.android" />
        <package android:name="com.snapchat.android" />
        <package android:name="com.reddit.frontpage" />
        <package android:name="com.pinterest" />
        <package android:name="com.linkedin.android" />
        <package android:name="com.tumblr" />
        <package android:name="com.imo.android.imoim" />
        <package android:name="com.likeme.app" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.google.android.apps.youtube.kids" />
        <package android:name="com.netflix.mediaclient" />
        <package android:name="tv.twitch.android.app" />
        <package android:name="com.spotify.music" />
        <package android:name="com.amazon.avod.thirdpartyclient" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="in.startv.hotstar" />
        <package android:name="com.mxtech.videoplayer.ad" />
        <package android:name="com.bongobd.bongobd" />
        <package android:name="com.dts.freefireth" />
        <package android:name="com.dts.freefiremax" />
        <package android:name="com.tencent.ig" />
        <package android:name="com.pubg.imobile" />
        <package android:name="com.pubg.krmobile" />
        <package android:name="com.activision.callofduty.shooter" />
        <package android:name="com.mobile.legends" />
        <package android:name="com.riotgames.league.wildrift" />
        <package android:name="com.supercell.clashofclans" />
        <package android:name="com.supercell.clashroyale" />
        <package android:name="com.supercell.brawlstars" />
        <package android:name="com.roblox.client" />
        <package android:name="com.innersloth.spacemafia" />
        <package android:name="com.nianticlabs.pokemongo" />
        <package android:name="com.king.candycrushsaga" />
        <package android:name="com.miniclip.eightballpool" />
        <package android:name="com.ludo.king" />
        <package android:name="com.ea.gp.fifamobile" />
        <package android:name="com.app.dream11Pro" />
        <package android:name="com.mpl.androidapp" />
        <package android:name="com.winzo.gold" />
        <package android:name="com.octro.teenpatti" />
        <package android:name="com.moonfrog.teenpatti.gold" />
        <package android:name="com.zupee.ludo" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SafeWorld">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SafeWorld">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The system starts this via the VPN consent flow, so it must declare
            BIND_VPN_SERVICE and the android.net.VpnService action. Android 14+
            additionally requires a foreground service type; a local filtering
            VPN has no better-fitting type than specialUse.
        -->
        <service
            android:name=".vpn.SafeWorldVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-device local VPN that filters DNS lookups to block harmful sites. No traffic leaves the device to any remote server." />
            <!--
                Declared explicitly rather than relying on the default. This is what makes Android
                offer the "Always-on VPN" and "Block connections without VPN" switches for this app,
                and those two settings are the only sanctioned answer to another VPN displacing us:
                the OS then restarts our tunnel itself and, with lockdown on, refuses to pass traffic
                while it is down. An app cannot do either for itself — there is no API to preempt
                another VPN, and Android 12+ forbids starting a foreground service from the
                background, so no watchdog can re-acquire the tunnel on its own.
            -->
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
        </service>

        <!--
            Device admin exists only so Android refuses to uninstall the app
            while it's active (uninstall friction). It requests no policies —
            see res/xml/device_admin.xml.
        -->
        <receiver
            android:name=".security.SafeWorldDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
            Restarts the tunnel after a reboot or an app update. Exported, because the sender is
            the system rather than us; the receiver itself does nothing an attacker could exploit —
            it starts protection, and only when the user had already enabled it.

            BOOT_COMPLETED and MY_PACKAGE_REPLACED are on Android 12's exemption list for starting
            a foreground service from the background, which is why only those are listed.
        -->
        <receiver
            android:name=".vpn.BootReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            Result callbacks from the PackageInstaller session that applies an
            update. Not exported: only the system sends to it, via the
            PendingIntent handed to session.commit().
        -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />
    </application>
</manifest>
