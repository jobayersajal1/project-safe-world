<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SafeWorld.App</RootNamespace>
    <AssemblyName>SafeWorld</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\SafeWorld.ico</ApplicationIcon>
    <!-- Lets this project restore/build from a non-Windows host (e.g. cross-compiling from
         macOS with `dotnet publish -r win-x64`); it does not affect the Windows machine it
         ultimately runs on. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Without this the assembly is stamped 1.0.0, which is both wrong in the file properties and
         the kind of default that later compares as *newer* than a real 0.x release — the same trap
         `CFBundleShortVersionString` fell into on the Apple side. -->
    <Version>0.5.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SafeWorld.Core\SafeWorld.Core.csproj" />
    <EmbeddedResource Include="Resources\SafeWorld.ico" />
  </ItemGroup>


  <!--
    The fuse filters are embedded so the release stays a single .exe, then extracted to
    %LOCALAPPDATA% on first run: memory-mapping needs a real file on disk, and a single-file
    bundle is not one. Same staging pattern the iOS app uses for its App Group container.
  -->
  <ItemGroup>
    <EmbeddedResource Include="filters\*.filter" LogicalName="filters.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
