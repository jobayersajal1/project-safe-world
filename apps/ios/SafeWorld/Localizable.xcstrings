    "pin_setup_required": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a PIN first, so turning protection off takes more than a tap."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগে একটি পিন দিন, যাতে সুরক্ষা বন্ধ করতে এক ট্যাপের বেশি লাগে।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura un PIN primero, para que desactivar la protección requiera más que un toque."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عيّن رمز PIN أولًا، حتى لا يكون إيقاف الحماية بضغطة واحدة."
          }
        }
      }
