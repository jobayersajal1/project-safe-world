    "tunnel_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari blocking covers Safari only. This filters every app on the device, and asks for a VPN configuration."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari ব্লকিং শুধু Safari-তে কাজ করে। এটি ডিভাইসের সব অ্যাপ ফিল্টার করে এবং একটি VPN কনফিগারেশন চায়।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bloqueo de Safari solo cubre Safari. Esto filtra todas las apps del dispositivo y pide una configuración VPN."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حظر Safari يغطي Safari فقط. هذا يصفّي كل تطبيق على الجهاز، ويطلب إعداد VPN."
          }
        }
      }
    },
    "tunnel_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block every app"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব অ্যাপে ব্লক করুন"
