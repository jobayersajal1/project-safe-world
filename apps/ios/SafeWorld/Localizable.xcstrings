    "appblock_consent_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocking an app means Safe World has to check every connection your phone makes, not just website lookups. That uses more battery. Nothing is sent anywhere — all the checking happens on this phone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো অ্যাপ ব্লক করতে হলে সেফ ওয়ার্ল্ডকে শুধু ওয়েবসাইটের খোঁজ নয়, আপনার ফোনের প্রতিটি সংযোগ পরীক্ষা করতে হয়। এতে ব্যাটারি একটু বেশি খরচ হয়। কোনো তথ্য কোথাও পাঠানো হয় না — সব পরীক্ষা এই ফোনেই হয়।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para bloquear una app, Safe World tiene que comprobar cada conexión que hace tu teléfono, no solo las búsquedas de webs. Eso gasta algo más de batería. No se envía nada a ninguna parte: todo se comprueba en este teléfono."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لحظر تطبيق، على Safe World فحص كل اتصال يجريه هاتفك، وليس عمليات البحث عن المواقع فقط. هذا يستهلك بطارية أكثر قليلًا. لا يُرسل أي شيء إلى أي جهة — كل الفحص يتم على هذا الهاتف."
          }
        }
      }
    },
    "appblock_consent_cancel": {
      "extractionState": "manual",
      "localizations": {
