        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই বিল্ডে পাওয়া যাচ্ছে না — এর জন্য App Store থেকে সাইন করা রিলিজ দরকার।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
