    "add_websites_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block anything else, by name."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নাম লিখে অন্য যেকোনো সাইট ব্লক করুন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea cualquier otro sitio por su nombre."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احظر أي موقع آخر بكتابة اسمه."
          }
        }
      }
    },
    "add_websites_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate them with commas. Subdomains are included."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কমা দিয়ে আলাদা করুন। সাবডোমেনও অন্তর্ভুক্ত হবে।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepáralos con comas. Se incluyen los subdominios."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افصل بينها بفواصل. النطاقات الفرعية مشمولة أيضًا."
          }
        }
      }
    },
