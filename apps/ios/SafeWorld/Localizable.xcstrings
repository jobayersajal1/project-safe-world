    "appblock_consent_accept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চালু করুন"
          }
        },
        "es": {
