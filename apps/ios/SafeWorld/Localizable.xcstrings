    "settings_allow_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One domain per line. Wins over every category and over the sites you added."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতি লাইনে একটি ডোমেইন। এটি সব ক্যাটাগরি এবং আপনার যোগ করা সাইটের চেয়ে অগ্রাধিকার পায়।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dominio por línea. Tiene prioridad sobre todas las categorías y sobre los sitios que añadiste."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نطاق واحد في كل سطر. له الأولوية على كل الفئات وعلى المواقع التي أضفتها."
          }
        }
      }
    },
