      }
    },
    "recovery_settings_label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery code"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিকভারি কোড"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código de recuperación"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز الاسترداد"
          }
        }
      }
    },
    "recovery_settings_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your way back in if you forget your PIN. It is stored hashed, so it can't be shown again — only replaced with a new one."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পিন ভুলে গেলে ফিরে আসার উপায়। এটি হ্যাশ করে রাখা হয়, তাই আবার দেখানো যায় না — শুধু নতুন একটি দিয়ে বদলানো যায়।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu forma de volver a entrar si olvidas el PIN. Se guarda cifrado con hash, así que no puede volver a mostrarse: solo se puede sustituir por uno nuevo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وسيلتك للعودة إذا نسيت رمز PIN. يُخزَّن مشفّرًا، لذا لا يمكن عرضه مرة أخرى — يمكن استبداله برمز جديد فقط."
          }
        }
      }
    },
    "recovery_settings_action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a new code"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন কোড নিন"
          }
