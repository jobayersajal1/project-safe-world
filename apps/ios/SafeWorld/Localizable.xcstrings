        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কমা দিয়ে আলাদা করুন। সাবডোমেনও অন্তর্ভুক্ত হবে।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepáralos con comas. Se incluyen los subdominios."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افصل بينها بفواصل. النطاقات الفرعية مشمولة أيضًا."
