    "recovery_none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No recovery code was ever saved on this device, so the PIN can't be reset here."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইসে কখনও রিকভারি কোড সংরক্ষণ করা হয়নি, তাই এখানে পিন রিসেট করা যাবে না।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca se guardó un código de recuperación en este dispositivo, así que el PIN no se puede restablecer aquí."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُحفظ أي رمز استرداد على هذا الجهاز، لذا لا يمكن إعادة تعيين رمز PIN هنا."
          }
        }
      }
    },
