    "help_intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuck, or something blocked that shouldn't be? Get in touch."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আটকে গেছেন, নাকি এমন কিছু ব্লক হয়েছে যা হওয়ার কথা নয়? যোগাযোগ করুন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Te has quedado atascado o se ha bloqueado algo que no debería? Escríbenos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل واجهتك مشكلة، أو حُظر موقع لا ينبغي حظره؟ تواصل معنا."
          }
        }
      }
    },
