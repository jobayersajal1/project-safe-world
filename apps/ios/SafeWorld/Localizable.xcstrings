    "recovery_show_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the only way back in if you forget your PIN. Write it down and keep it somewhere you'll still have it in a year — it will not be shown again."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পিন ভুলে গেলে এটিই ফিরে আসার একমাত্র উপায়। লিখে রাখুন এবং এমন জায়গায় রাখুন যেখানে এক বছর পরেও পাবেন — এটি আর দেখানো হবে না।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es la única forma de volver a entrar si olvidas tu PIN. Anótalo y guárdalo en un sitio donde lo sigas teniendo dentro de un año: no se volverá a mostrar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه هي الطريقة الوحيدة للعودة إذا نسيت رمز PIN. اكتبه واحتفظ به في مكان ستجده فيه بعد عام — لن يُعرض مرة أخرى."
          }
        }
      }
    },
