    "pin_choose_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll need this PIN to turn protection off or change your lists. Pick something you won't guess at in a weak moment."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সুরক্ষা বন্ধ করতে বা তালিকা বদলাতে এই পিন লাগবে। দুর্বল মুহূর্তে অনুমান করে ফেলবেন না, এমন কিছু বাছুন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitarás este PIN para desactivar la protección o cambiar tus listas. Elige algo que no vayas a adivinar en un momento de debilidad."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستحتاج إلى هذا الرمز لإيقاف الحماية أو تغيير قوائمك. اختر شيئًا لن تخمّنه في لحظة ضعف."
          }
        }
      }
    },
