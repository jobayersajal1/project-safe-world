    "protection_on": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtering DNS lookups on this device."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইসে DNS অনুসন্ধান ফিল্টার করা হচ্ছে।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtrando consultas DNS en este dispositivo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم تصفية طلبات DNS على هذا الجهاز."
          }
        }
      }
    },
    "protection_off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off — nothing is being blocked."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বন্ধ — কিছুই ব্লক করা হচ্ছে না।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivada: no se está bloqueando nada."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متوقّفة — لا يتم حظر أي شيء."
          }
        }
      }
    },
    "protection_off_pin_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off protection?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সুরক্ষা বন্ধ করবেন?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Desactivar la protección?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف الحماية؟"
          }
        }
      }
    },
    "protection_off_pin_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your PIN to stop blocking on this device."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইসে ব্লক করা বন্ধ করতে আপনার পিন দিন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce tu PIN para dejar de bloquear en este dispositivo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل رمز PIN لإيقاف الحظر على هذا الجهاز."
          }
        }
      }
    },
    "blocked_headline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We've blocked %1$@ websites"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমরা %1$@টি ওয়েবসাইট ব্লক করেছি"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemos bloqueado %1$@ sitios web"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حظرنا %1$@ موقع إلكتروني"
          }
        }
      }
    },
    "blocked_headline_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ known sites, kept up to date automatically."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@টি পরিচিত সাইট, স্বয়ংক্রিয়ভাবে হালনাগাদ হয়।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sitios conocidos, actualizados automáticamente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ موقع معروف، يتم تحديثها تلقائيًا."
          }
        }
      }
    },
    "block_more_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
