    "recovery_replaced": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recovery code has been used. Here is a new one — save it as well."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার রিকভারি কোডটি ব্যবহার করা হয়েছে। এই নতুন কোডটিও সংরক্ষণ করুন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu código de recuperación ya se ha usado. Aquí tienes uno nuevo: guárdalo también."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم استخدام رمز الاسترداد الخاص بك. إليك رمزًا جديدًا — احفظه أيضًا."
          }
        }
      }
    },
