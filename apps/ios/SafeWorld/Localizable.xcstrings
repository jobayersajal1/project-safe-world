    "recovery_enter_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 20-character code you saved when you set up your PIN. Dashes and capitals don't matter."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পিন সেট করার সময় সংরক্ষণ করা ২০ অক্ষরের কোডটি। ড্যাশ ও বড় হাতের অক্ষর গুরুত্বপূর্ণ নয়।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código de 20 caracteres que guardaste al configurar tu PIN. Los guiones y las mayúsculas no importan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرمز المكوّن من 20 حرفًا الذي حفظته عند إعداد رمز PIN. الشرطات وحالة الأحرف غير مهمة."
          }
        }
      }
    },
