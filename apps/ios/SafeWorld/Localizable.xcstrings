    "add_websites_remove_pin_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your PIN to stop blocking sites you added."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার যোগ করা সাইট ব্লক করা বন্ধ করতে পিন দিন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce tu PIN para dejar de bloquear sitios que añadiste."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل رمز PIN لإيقاف حظر المواقع التي أضفتها."
          }
        }
      }
    },
