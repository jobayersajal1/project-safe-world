    "protection_on_ios": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocking in Safari on this device."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইসের Safari-তে ব্লক করা হচ্ছে।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueando en Safari en este dispositivo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم الحظر في Safari على هذا الجهاز."
          }
        }
      }
    },
    "safari_enable_action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Safari extension"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari এক্সটেনশন চালু করুন"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar la extensión de Safari"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تفعيل إضافة Safari"
          }
        }
      }
    },
    "safari_enable_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Settings, go to Apps ▸ Safari ▸ Extensions and turn on Safe World."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেটিংসে গিয়ে Apps ▸ Safari ▸ Extensions থেকে Safe World চালু করুন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Ajustes, ve a Apps ▸ Safari ▸ Extensiones y activa Safe World."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الإعدادات، انتقل إلى التطبيقات ▸ Safari ▸ الإضافات وفعّل Safe World."
          }
        }
      }
    },
    "tunnel_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block every app"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব অ্যাপে ব্লক করুন"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear todas las apps"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حظر كل التطبيقات"
          }
        }
      }
    },
    "tunnel_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari blocking covers Safari only. This filters every app on the device, and asks for a VPN configuration."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari ব্লকিং শুধু Safari-তে কাজ করে। এটি ডিভাইসের সব অ্যাপ ফিল্টার করে এবং একটি VPN কনফিগারেশন চায়।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bloqueo de Safari solo cubre Safari. Esto filtra todas las apps del dispositivo y pide una configuración VPN."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حظر Safari يغطي Safari فقط. هذا يصفّي كل تطبيق على الجهاز، ويطلب إعداد VPN."
          }
        }
      }
    },
    "tunnel_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not available in this build — it needs a signed release from the App Store."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই বিল্ডে পাওয়া যাচ্ছে না — এর জন্য App Store থেকে সাইন করা রিলিজ দরকার।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No disponible en esta compilación: requiere una versión firmada de la App Store."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير متاح في هذه النسخة — يتطلب إصدارًا موقّعًا من App Store."
          }
        }
      }
    },
    "update_ios_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS apps can only be updated through the App Store, so this opens the release page."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS অ্যাপ কেবল App Store দিয়েই আপডেট হয়, তাই এটি রিলিজ পেজ খুলবে।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps de iOS solo se actualizan desde la App Store, así que esto abre la página de la versión."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تحديث تطبيقات iOS إلا عبر App Store، لذا يفتح هذا صفحة الإصدار."
          }
        }
      }
    },
