          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইসে কখনও রিকভারি কোড সংরক্ষণ করা হয়নি, তাই এখানে পিন রিসেট করা যাবে না।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca se guardó un código de recuperación en este dispositivo, así que el PIN no se puede restablecer aquí."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُحفظ أي رمز استرداد على هذا الجهاز، لذا لا يمكن إعادة تعيين رمز PIN هنا."
          }
        }
      }
    },
    "recovery_replaced": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recovery code has been used. Here is a new one — save it as well."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার রিকভারি কোডটি ব্যবহার করা হয়েছে। এই নতুন কোডটিও সংরক্ষণ করুন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu código de recuperación ya se ha usado. Aquí tienes uno nuevo: guárdalo también."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم استخدام رمز الاسترداد الخاص بك. إليك رمزًا جديدًا — احفظه أيضًا."
          }
        }
      }
    },
    "recovery_settings_action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a new code"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন কোড নিন"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtener un código nuevo"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصل على رمز جديد"
          }
        }
      }
    },
    "recovery_settings_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your way back in if you forget your PIN. It is stored hashed, so it can't be shown again — only replaced with a new one."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পিন ভুলে গেলে ফিরে আসার উপায়। এটি হ্যাশ করে রাখা হয়, তাই আবার দেখানো যায় না — শুধু নতুন একটি দিয়ে বদলানো যায়।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu forma de volver a entrar si olvidas el PIN. Se guarda cifrado con hash, así que no puede volver a mostrarse: solo se puede sustituir por uno nuevo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وسيلتك للعودة إذا نسيت رمز PIN. يُخزَّن مشفّرًا، لذا لا يمكن عرضه مرة أخرى — يمكن استبداله برمز جديد فقط."
          }
        }
      }
    },
    "recovery_settings_label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery code"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিকভারি কোড"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código de recuperación"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز الاسترداد"
          }
        }
      }
    },
    "recovery_settings_pin_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your PIN to replace your recovery code."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিকভারি কোড বদলাতে আপনার পিন দিন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce tu PIN para sustituir tu código de recuperación."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل رمز PIN لاستبدال رمز الاسترداد."
          }
        }
      }
    },
    "recovery_show_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the only way back in if you forget your PIN. Write it down and keep it somewhere you'll still have it in a year — it will not be shown again."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পিন ভুলে গেলে এটিই ফিরে আসার একমাত্র উপায়। লিখে রাখুন এবং এমন জায়গায় রাখুন যেখানে এক বছর পরেও পাবেন — এটি আর দেখানো হবে না।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es la única forma de volver a entrar si olvidas tu PIN. Anótalo y guárdalo en un sitio donde lo sigas teniendo dentro de un año: no se volverá a mostrar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه هي الطريقة الوحيدة للعودة إذا نسيت رمز PIN. اكتبه واحتفظ به في مكان ستجده فيه بعد عام — لن يُعرض مرة أخرى."
          }
        }
      }
    },
    "recovery_show_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your recovery code"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার রিকভারি কোড সংরক্ষণ করুন"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tu código de recuperación"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ رمز الاسترداد"
          }
        }
      }
    },
