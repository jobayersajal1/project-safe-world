{
  "manifest_version": 3,
  "name": "Safe World",
  "version": "0.6.0",
  "description": "Protect yourself from scam, gambling, and adult/haram content by blocking known-bad sites.",
  "minimum_chrome_version": "109",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms",
    "webNavigation",
    "offscreen",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/blur.ts"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Safe World"
  },
  "options_page": "src/options/options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/blocked/blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
